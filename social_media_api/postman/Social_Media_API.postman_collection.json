{
  "info": {
    "_postman_id": "4d8dcf7e-e8c7-4dd9-9df0-8bd4e84f7f09",
    "name": "Social Media API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Starter collection for authentication and profile endpoints."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"first_name\": \"Lameck\",\n  \"last_name\": \"Tester\",\n  \"bio\": \"First test user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "register",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.test('Token is returned', function () {",
                  "  pm.expect(data).to.have.property('token');",
                  "});",
                  "pm.test('User payload is returned', function () {",
                  "  pm.expect(data).to.have.property('user');",
                  "  pm.expect(data.user).to.have.property('id');",
                  "});",
                  "",
                  "if (data.token) { pm.environment.set('token', data.token); }",
                  "if (data.user && data.user.id) { pm.environment.set('user_id', String(data.user.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const data = pm.response.json();",
                  "pm.test('Token is returned on login', function () {",
                  "  pm.expect(data).to.have.property('token');",
                  "});",
                  "if (data.token) { pm.environment.set('token', data.token); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile (auth)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/profile/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "profile",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Has username field', function () {",
                  "  pm.expect(data).to.have.property('username');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Profile (auth)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Updated bio from Postman\",\n  \"first_name\": \"Lameck\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/profile/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "profile",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Bio updates', function () {",
                  "  pm.expect(data.bio).to.eql('Updated bio from Postman');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
